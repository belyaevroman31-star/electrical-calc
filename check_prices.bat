@echo off
chcp 65001 >nul
echo ============================================
echo  Проверка цен el.ru - Калькулятор электрика
echo ============================================
echo.
echo Выберите режим:
echo   1. Только проверка (без изменений)
echo   2. Проверка + обновление калькуляторов
echo.
set /p choice="Ваш выбор (1/2): "

if "%choice%"=="1" (
    python "D:\сайт\калькулятор материалов\check_prices.py"
